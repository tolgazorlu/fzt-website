# Admin paneli için şifre (bcrypt hash - client'ta asla plain text saklanmaz)
# Varsayılan: Fzt#Admin2025!Guvenli
# Kendi şifreniz için: node -e "console.log(require('bcryptjs').hashSync('SIFRENIZ', 12))"
# ADMIN_PASSWORD_HASH=$2b$12$...

# JWT oturum güvenliği (üretimde mutlaka değiştirin)
# JWT_SECRET=rastgele-guvenli-bir-anahtar

# Vercel'de kalıcı veri için Redis (ZORUNLU - randevu/blog kaybolmasını önler)
# Vercel Dashboard → Storage → Upstash Redis ekleyin, env otomatik eklenir
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# veya: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
