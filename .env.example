# JWT signing secret for admin sessions
JWT_SECRET=

# JWT signing secret for patient sessions (falls back to JWT_SECRET if unset)
PATIENT_JWT_SECRET=

# Bcrypt hash of the admin password (overrides the built-in default)
ADMIN_PASSWORD_HASH=

# Appointment storage on Vercel (read-only filesystem): Vercel KV or Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
